+/**
+ * Scanner for the /proc/<pid>/maps text format.
+ *
+ * QueryProtect() runs inside the guest write-watch fault handler, so the cost
+ * of one query is paid on every watched-page fault. The scanner therefore
+ * avoids heap allocation and stdio, stops as soon as the answer is known (the
+ * kernel lists mappings in ascending address order) and only needs a small
+ * fixed buffer, which keeps it usable on a signal stack.
+ *
+ * The reader is injected so the logic can be tested without a live process.
+ */
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace rex::memory::detail {
+
+struct ProcMapsEntry {
+  uintptr_t start = 0;
+  uintptr_t end = 0;
+  char perms[5] = {};
+};
+
+namespace proc_maps_internal {
+
+inline int HexValue(char c) {
+  if (c >= '0' && c <= '9') return c - '0';
+  if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+  if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+  return -1;
+}
+
+// Parses 1-16 hex digits; stops at the first non-hex character.
+inline bool ParseHex(const char* text, size_t length, size_t& pos, uint64_t& value) {
+  value = 0;
+  size_t digits = 0;
+  while (pos < length) {
+    const int digit = HexValue(text[pos]);
+    if (digit < 0) break;
+    if (++digits > 16) return false;
+    value = (value << 4) | static_cast<uint64_t>(digit);
+    ++pos;
+  }
+  return digits != 0;
+}
+
+}  // namespace proc_maps_internal
+
+// Parses "<start>-<end> <perms> ..." and ignores the remainder of the line.
+// Matches the former sscanf("%llx-%llx %4s") contract: all three fields are
+// required and the range must be non-empty.
+inline bool ParseProcMapsLine(const char* line, size_t length, ProcMapsEntry& out) {
+  out = ProcMapsEntry{};
+  size_t pos = 0;
+  uint64_t start = 0;
+  uint64_t end = 0;
+  if (!proc_maps_internal::ParseHex(line, length, pos, start)) return false;
+  if (pos >= length || line[pos] != '-') return false;
+  ++pos;
+  if (!proc_maps_internal::ParseHex(line, length, pos, end)) return false;
+  if (pos >= length || line[pos] != ' ') return false;
+  ++pos;
+  size_t perm_count = 0;
+  while (pos < length && perm_count < 4 && line[pos] != ' ' && line[pos] != '\t' &&
+         line[pos] != '\r') {
+    out.perms[perm_count++] = line[pos++];
+  }
+  if (perm_count == 0 || start >= end) return false;
+  out.start = static_cast<uintptr_t>(start);
+  out.end = static_cast<uintptr_t>(end);
+  return true;
+}
+
+// Calls visit(entry) for each parsed mapping in file order until it returns
+// false or the source ends. read(buffer, capacity) returns the number of bytes
+// produced, 0 at end of file or a negative value on error (which stops the
+// scan). Lines longer than the internal buffer still deliver their prefix once
+// and the remainder is skipped.
+template <typename Read, typename Visit>
+void ForEachProcMapsEntry(Read&& read, Visit&& visit) {
+  constexpr size_t kCapacity = 4096;
+  char buffer[kCapacity];
+  size_t held = 0;
+  bool skipping = false;  // discarding the tail of an over-long line
+  ProcMapsEntry entry;
+  for (;;) {
+    const std::ptrdiff_t produced = read(buffer + held, kCapacity - held);
+    if (produced < 0) return;
+    const bool end_of_file = produced == 0;
+    held += static_cast<size_t>(produced);
+
+    size_t pos = 0;
+    while (pos < held) {
+      const void* newline = std::memchr(buffer + pos, '\n', held - pos);
+      if (!newline) break;
+      const size_t line_end = static_cast<size_t>(static_cast<const char*>(newline) - buffer);
+      if (skipping) {
+        skipping = false;
+      } else if (ParseProcMapsLine(buffer + pos, line_end - pos, entry) && !visit(entry)) {
+        return;
+      }
+      pos = line_end + 1;
+    }
+
+    if (end_of_file) {
+      if (!skipping && pos < held && ParseProcMapsLine(buffer + pos, held - pos, entry)) {
+        visit(entry);
+      }
+      return;
+    }
+
+    held -= pos;
+    std::memmove(buffer, buffer + pos, held);
+    if (held == kCapacity) {
+      if (!skipping) {
+        if (ParseProcMapsLine(buffer, held, entry) && !visit(entry)) return;
+        skipping = true;
+      }
+      held = 0;
+    }
+  }
+}
+
+// Finds the mapping containing `address`. Mappings are sorted, so the scan
+// ends at the first entry that starts above it.
+template <typename Read>
+bool FindProcMapsEntry(Read&& read, uintptr_t address, ProcMapsEntry& out) {
+  bool found = false;
+  ForEachProcMapsEntry(read, [&](const ProcMapsEntry& entry) {
+    if (address >= entry.start && address < entry.end) {
+      out = entry;
+      found = true;
+      return false;
+    }
+    return entry.start <= address;
+  });
+  return found;
+}
+
+// True when [begin, end) is covered by adjacent mappings with no gap.
+template <typename Read>
+bool IsProcMapsRangeMapped(Read&& read, uintptr_t begin, uintptr_t end) {
+  if (begin >= end) return false;
+  uintptr_t cursor = begin;
+  bool mapped = false;
+  ForEachProcMapsEntry(read, [&](const ProcMapsEntry& entry) {
+    if (entry.end <= cursor) return true;
+    if (entry.start > cursor) return false;  // gap
+    cursor = entry.end;
+    if (cursor >= end) {
+      mapped = true;
+      return false;
+    }
+    return true;
+  });
+  return mapped;
+}
+
+}  // namespace rex::memory::detail
