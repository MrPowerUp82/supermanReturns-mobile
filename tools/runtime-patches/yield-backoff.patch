 namespace rex::kernel::xboxkrnl {
 using namespace rex::system;
 using rex::runtime::current_ppc_context;
@@ -389,6 +397,31 @@ u32 KeDelayExecutionThread_entry(u32 processor_mode, u32 alertable, mapped_u64 i
 }
 
 u32 NtYieldExecution_entry() {
+  // Guest code spins on SwitchToThread while it waits for work. After a long run
+  // of rapid yields from one thread, sleep briefly instead so idle spinners do not
+  // hold cores that threads doing real work need. Off unless
+  // SR_YIELD_BACKOFF_US is set; SR_YIELD_BACKOFF_STREAK and SR_YIELD_BACKOFF_GAP_US
+  // tune when it starts (see core/yield_backoff.h).
+  static const rex::thread::detail::YieldBackoffConfig backoff_config =
+      rex::thread::detail::YieldBackoffConfig::Parse(std::getenv("SR_YIELD_BACKOFF_US"),
+                                                     std::getenv("SR_YIELD_BACKOFF_STREAK"),
+                                                     std::getenv("SR_YIELD_BACKOFF_GAP_US"));
+  if (backoff_config.sleep_us) {
+    thread_local rex::thread::detail::YieldBackoff backoff;
+    const uint64_t now_ns = static_cast<uint64_t>(
+        std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::steady_clock::now().time_since_epoch())
+            .count());
+    if (const uint32_t sleep_us = backoff.OnYield(now_ns, backoff_config)) {
+#if REX_PLATFORM_LINUX || REX_PLATFORM_ANDROID
+      // The default 50 us timer slack would double a 50 us sleep.
+      thread_local const bool slack_set = (prctl(PR_SET_TIMERSLACK, 1000UL, 0, 0, 0), true);
+      (void)slack_set;
+#endif
+      rex::thread::Sleep(std::chrono::microseconds(sleep_us));
+      return X_STATUS_SUCCESS;
+    }
+  }
   rex::thread::MaybeYield();
   return X_STATUS_SUCCESS;
 }
