@@ -0,0 +1,50 @@
+#include "guest_reads_android.h"
+#include <rex/system/xmemory.h>
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+
+namespace superman_returns::native {
+const uint8_t* ValidatedGuestPointer(rex::memory::Memory& memory,uint32_t address,size_t size,std::string& error) {
+  error.clear();
+  auto fail=[&](const char* why)->const uint8_t* {
+    char context[128];std::snprintf(context,sizeof(context),"Guest read %08X + %zu: %s",address,size,why);
+    error=context;return nullptr;
+  };
+  if(!size || size>0x20000000ull || uint64_t(address)+size>0x100000000ull)
+    return fail("invalid or overflowing range");
+  uint32_t query=address;
+  rex::memory::BaseHeap* heap=nullptr;
+  const uint8_t* result=nullptr;
+  if(address>=0xA0000000u) {
+    uint64_t physical=uint64_t(address&0x1FFFFFFFu)+(address>=0xE0000000u?0x1000:0);
+    if(physical+size>0x20000000ull) return fail("physical mapping exceeded");
+    query=uint32_t(physical);heap=memory.GetPhysicalHeap();
+    result=memory.TranslatePhysical<const uint8_t*>(query);
+  } else {
+    heap=memory.LookupHeap(address);
+    if(!heap) return fail("unmapped guest address");
+    result=memory.TranslateVirtual<const uint8_t*>(address);
+  }
+  const uint64_t end=uint64_t(query)+size;
+  if(query<heap->heap_base() || end>uint64_t(heap->heap_base())+heap->heap_size())
+    return fail("read crosses guest heap boundary");
+  for(uint64_t current=query;current<end;) {
+    rex::memory::HeapAllocationInfo info{};
+    const uint32_t page=uint32_t(current)&~(heap->page_size()-1);
+    if(!heap->QueryRegionInfo(page,&info) ||
+       !(info.state&rex::memory::kMemoryAllocationCommit) ||
+       !(info.protect&rex::memory::kMemoryProtectRead)) return fail("uncommitted or unreadable guest pages");
+    const uint64_t next=uint64_t(info.base_address)+info.region_size;
+    if(next<=current) return fail("invalid heap region extent");
+    current=std::min(next,end);
+  }
+  return result;
+}
+bool ReadGuestBytes(rex::memory::Memory& memory,uint32_t address,size_t size,std::vector<uint8_t>& out,std::string& error) {
+  out.clear();
+  auto source=ValidatedGuestPointer(memory,address,size,error);
+  if(!source) return false;
+  out.resize(size);std::memcpy(out.data(),source,size);return true;
+}
