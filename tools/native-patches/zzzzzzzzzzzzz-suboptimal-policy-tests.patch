+SR_TEST(intentional_wsi_rotation_presents_suboptimal_without_recreate_storm) {
+  Fixture f;f.s.allow_suboptimal=true;
+  acquire_result=VK_SUBOPTIMAL_KHR;present_result=VK_SUBOPTIMAL_KHR;
+  for(int i=0;i<8;++i) SR_CHECK(f.Draw()==FrameOutcome::kPresented);
+  SR_CHECK_EQ(f.loop.presented,8u);
+  acquire_result=VK_ERROR_OUT_OF_DATE_KHR;SR_CHECK(f.Draw()==FrameOutcome::kRecreate);
+  acquire_result=VK_SUCCESS;present_result=VK_ERROR_OUT_OF_DATE_KHR;SR_CHECK(f.Draw()==FrameOutcome::kRecreate);
+  present_result=VK_ERROR_DEVICE_LOST;SR_CHECK(f.Draw()==FrameOutcome::kFailed);
+}
