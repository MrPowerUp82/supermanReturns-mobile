+#include "texture_filter.h"
+#include <algorithm>
+namespace superman_returns::graphics::vulkan {
+bool PlanTextureSampling(std::span<const uint32_t,6> fetch,VkFormat format,VkFormatFeatureFlags features,
+                         TextureDimension dimension,uint32_t slot,TextureSamplingPlan& out,Error& e) {
+  auto fail=[&](const char* reason) {
+    e={"Texture filtering",VK_ERROR_FORMAT_NOT_SUPPORTED,std::string(reason)+
+      ": format="+std::to_string(format)+" slot="+std::to_string(slot)+
+      " dimension="+std::to_string(uint32_t(dimension))+" fetch3="+std::to_string(fetch[3])};return false;
+  };
+  if(slot>=32) return fail("Invalid sampler slot");
+  TextureSamplingPlan next;next.sampler_word=slot;std::copy(fetch.begin(),fetch.end(),next.sampler_fetch.begin());
+  if((fetch[0]&3)==2) {
+    uint32_t mag=(fetch[3]>>19)&3,min=(fetch[3]>>21)&3,mip=(fetch[3]>>23)&3,aniso=(fetch[3]>>25)&7;
+    if(mag>1 || min>1 || mip>2) return fail("Unresolved guest filter");
+    bool needsLinear=mag==1 || min==1 || mip==1 || aniso>1;
+    if(needsLinear && !(features&VK_FORMAT_FEATURE_SAMPLED_IMAGE_FILTER_LINEAR_BIT)) {
+      if(dimension!=TextureDimension::k2D || (format!=VK_FORMAT_R32_SFLOAT && format!=VK_FORMAT_R32G32_SFLOAT && format!=VK_FORMAT_R32G32B32A32_SFLOAT)) return fail("Manual filter format/dimension is unsupported");
+      if(aniso>1) return fail("Manual anisotropy is unsupported");
+      for(uint32_t shift:{10u,13u,16u}) {uint32_t address=(fetch[0]>>shift)&7;if(address==3 || address==5 || address==7) return fail("Manual mirror-clamp is unvalidated");}
+      next.manual=true;next.sampler_word=slot|32u|(mag<<6)|(min<<7)|(mip<<8);
+      next.sampler_fetch[3]&=~0x0ff80000u;
+    }
+  }
+  out=next;e={};return true;
+}
+}
